# Base URL of the NestJS API (includes the /api/v1 prefix).
# Leave UNSET in dev so the app auto-follows the page host (works via both
# http://localhost:5000 and your LAN IP). Set it explicitly only for prod/remote.
# NEXT_PUBLIC_API_URL=http://localhost:5001/api/v1

# Dev only: extra origins allowed to reach Next.js dev resources (HMR websocket)
# — your LAN IP(s), comma-separated, hostname only. localhost is always allowed.
# e.g. DEV_ALLOWED_ORIGINS=192.168.1.42
DEV_ALLOWED_ORIGINS=
