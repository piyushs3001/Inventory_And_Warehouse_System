// Prisma schema — see https://pris.ly/d/prisma-schema
// pgvector deferred to the AI phase.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  WAREHOUSE_MANAGER
  STAFF
  SUPPLIER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING_APPROVAL
}

enum WarehouseStatus {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  ACTIVE
  ARCHIVED
}

model User {
  id                 String      @id @default(uuid())
  name               String
  email              String      @unique
  passwordHash       String      @map("password_hash")
  role               Role        @default(STAFF)
  status             UserStatus  @default(ACTIVE)
  hashedRefreshToken String?     @map("hashed_refresh_token")
  warehouses         Warehouse[] @relation("UserWarehouses")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  @@map("users")
}

model Warehouse {
  id            String          @id @default(uuid())
  name          String
  address       String?
  contactPerson String?         @map("contact_person")
  capacity      Int?
  status        WarehouseStatus @default(ACTIVE)
  users         User[]          @relation("UserWarehouses")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@map("warehouses")
}

// Global product catalog reference data (not warehouse-scoped). Optional
// self-referential nesting via parentId. Slice 3 adds `products Product[]`
// and extends the delete dependency check to products.
model Category {
  id        String     @id @default(uuid())
  name      String
  parentId  String?    @map("parent_id")
  parent    Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryHierarchy")
  products  Product[]
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@index([parentId])
  @@map("categories")
}

// Global product catalog (not warehouse-scoped). Money fields are Decimal
// (never Float); soft-delete via status ARCHIVED. SKU is unique across
// products (variants share the SKU space from Slice 4).
model Product {
  id           String        @id @default(uuid())
  name         String
  sku          String        @unique
  description  String?
  categoryId   String?       @map("category_id")
  category     Category?     @relation(fields: [categoryId], references: [id])
  unit         String?
  costPrice    Decimal       @default(0) @db.Decimal(12, 2) @map("cost_price")
  sellingPrice Decimal       @default(0) @db.Decimal(12, 2) @map("selling_price")
  reorderLevel Int           @default(0) @map("reorder_level")
  status       ProductStatus @default(ACTIVE)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt      @map("updated_at")

  @@index([categoryId])
  @@map("products")
}
