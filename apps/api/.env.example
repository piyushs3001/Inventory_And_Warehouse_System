NODE_ENV=development
PORT=5001
# Allowed browser origin(s) for CORS (the web app). Comma-separate for multiple
# (add your LAN IP origin to use the app from another device, e.g.
# http://localhost:5000,http://192.168.1.42:5000).
CORS_ORIGIN=http://localhost:5000
DATABASE_URL=postgresql://iws:iws_password@127.0.0.1:5432/iws?schema=public
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh

# ── Storage ───────────────────────────────────────────────────────────────────
# STORAGE_DRIVER selects the storage backend. Defaults to "local" when unset.
#   local — files are written to STORAGE_LOCAL_DIR and served via /uploads
#   s3    — files are written to an S3-compatible bucket (MinIO in development)
#STORAGE_DRIVER=local

# Local-storage settings (used when STORAGE_DRIVER=local or unset).
# STORAGE_LOCAL_DIR: absolute path to the upload directory.
#   Defaults to <monorepo-root>/var/uploads when unset.
#STORAGE_LOCAL_DIR=/absolute/path/to/var/uploads

# PUBLIC_FILES_BASE_URL: base URL prepended to storage keys to form imageUrl.
#   Defaults to http://localhost:5002 when unset.
#PUBLIC_FILES_BASE_URL=http://localhost:5002

# S3/MinIO settings — only required when STORAGE_DRIVER=s3.
#S3_ENDPOINT=http://localhost:9000
#S3_ACCESS_KEY=minio
#S3_SECRET_KEY=minio_password
#S3_BUCKET=iws
