NODE_ENV=development
PORT=5001
# Allowed browser origin(s) for CORS (the web app). Comma-separate for multiple
# (add your LAN IP origin to use the app from another device, e.g.
# http://localhost:5000,http://192.168.1.42:5000).
CORS_ORIGIN=http://localhost:5000
DATABASE_URL=postgresql://iws:iws_password@127.0.0.1:5432/iws?schema=public
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
# Object storage (MinIO/S3) is introduced in a later phase — placeholders for now.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio_password
S3_BUCKET=iws

# SMTP transport for password-reset emails. Optional: if unset, the reset flow
# still works but no email is sent (the reset URL is logged in non-production).
# For Gmail use an App Password (not your account password): smtp.gmail.com:465.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@example.com
SMTP_PASS=your-app-password
MAIL_FROM="Inventory & Warehouse System <you@example.com>"
# Base URLs used to build password-reset links back to each app.
STAFF_APP_URL=http://localhost:5000
ADMIN_APP_URL=http://localhost:5001
