NODE_ENV=development
PORT=5001
# Allowed browser origin(s) for CORS (the web app). Comma-separate for multiple
# (add your LAN IP origin to use the app from another device, e.g.
# http://localhost:5000,http://192.168.1.42:5000).
CORS_ORIGIN=http://localhost:5000
DATABASE_URL=postgresql://iws:iws_password@127.0.0.1:5432/iws?schema=public
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
# Object storage (MinIO/S3) is introduced in a later phase — placeholders for now.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio_password
S3_BUCKET=iws
