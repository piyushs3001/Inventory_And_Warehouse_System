# ---- Dependencies ----
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---- Build output ----
# NestJS
dist/
build/
# Next.js
.next/
out/
# Generic
*.tsbuildinfo
next-env.d.ts

# ---- Environment & secrets ----
.env
.env.*
!.env.example
!.env.*.example
*.pem

# ---- Prisma ----
# Generated client (regenerated via `prisma generate`)
**/generated/prisma
# Local migration shadow / dev artifacts
prisma/*.db
prisma/*.db-journal

# ---- Tests & coverage ----
coverage/
.nyc_output/
*.lcov

# ---- Logs ----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Caches ----
.cache/
.turbo/
.eslintcache
.prettiercache
*.tgz

# ---- Local data / storage (MinIO, uploads, exports) ----
/data/
/storage/
/uploads/
/minio-data/

# ---- IDE / Editor ----
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Misc ----
*.local
.vercel
tmp/
temp/

# ---- Claude Code ----
.claude/
CLAUDE.md

# ---- Project docs (PRD / internal blueprint) ----
# Ignore docs/ contents, but TRACK QA reports (docs/qa/) — they are
# Definition-of-Done evidence and the Stop-hook QA gate looks for them in git.
docs/*
!docs/qa/
